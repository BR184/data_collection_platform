# 本文件只描述本地启动契约。复制为 .env.local 后填写真实值；不要提交 .env.local。
DATASOURCE_URL=jdbc:postgresql://127.0.0.1:15432/qaflex
DATASOURCE_USERNAME=qaflex
DATASOURCE_PASSWORD=replace-with-local-database-password
PLATFORM_SECURE_CONFIG_REQUIRED=false

# 当前产品默认使用 LDAP。仅在明确测试本地账号时改为 local。
PLATFORM_AUTH_PROVIDER=ldap
PLATFORM_LDAP_BASE_URL=http://127.0.0.1:24837
PLATFORM_LDAP_CONNECT_TIMEOUT_MS=3000
PLATFORM_LDAP_READ_TIMEOUT_MS=10000
PLATFORM_LDAP_INITIAL_SYNC_REQUIRED=true

# 外部 API 默认关闭。开启时必须同时配置客户端、摘要和数据集白名单。
PLATFORM_EXTERNAL_API_ENABLED=false
# PLATFORM_EXTERNAL_API_CLIENTS_0_CLIENT_ID=bi-dashboard
# PLATFORM_EXTERNAL_API_CLIENTS_0_TOKEN_SHA256=replace-with-64-character-sha256
# PLATFORM_EXTERNAL_API_CLIENTS_0_ALLOWED_DATASETS_0=bi-dashboard
# PLATFORM_EXTERNAL_API_CLIENTS_0_ALLOWED_DATASETS_1=system-test-module-fix-rates
